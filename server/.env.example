# ===== 服务 =====
PORT=3000
NODE_ENV=development

# ===== 安全 =====
# 生产环境务必修改为随机长字符串
JWT_SECRET=cms-default-jwt-secret-change-me-in-production
# 管理端 access token 有效期(秒)
ACCESS_TOKEN_TTL=7200
# refresh token 有效期(秒)
REFRESH_TOKEN_TTL=604800
# 设备 token 有效期(秒)
DEVICE_TOKEN_TTL=2592000

# ===== 数据库 =====
# 默认 SQLite(零配置)。切换 MySQL: DB_CLIENT=mysql2 并填写下面连接信息
DB_CLIENT=better-sqlite3
DB_FILE=./data/cms.sqlite
# DB_CLIENT=mysql2
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=yourpassword
# DB_NAME=cms

# ===== 素材审核 =====
# true: 上传即自动通过(开发/演示); false: 需审核员先审后发(生产建议)
AUTO_APPROVE=true

# ===== 对外访问地址 =====
# 留空则按请求 Host 生成素材下载 URL; 有域名/CDN 时填写, 如 https://cdn.example.com
PUBLIC_BASE_URL=

# ===== Cloudflare R2 对象存储 (可选) =====
# 四项全部填写后自动启用, 素材存 R2; 留空则存本地磁盘
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ===== 部署磁盘路径 (Render/PaaS 挂载持久盘时) =====
# DATA_DIR=/data/db
# UPLOADS_DIR=/data/uploads
